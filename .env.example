# Copy to .env.local (never committed) and fill in from Supabase: Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses row-level security; used by /api/reports (rule A).
SUPABASE_SERVICE_ROLE_KEY=
# Server/CLI only. Used to push migrations and the seed: Project Settings > Database > Connection string
# (use the "Session pooler" URI, with your database password filled in).
SUPABASE_DB_URL=
# Server only. Rule A: a long random secret mixed into device hashes (never commit the real one).
REPORT_HASH_SECRET=
# Server only. Signs staff session cookies, real accounts and the demo login (a long random secret).
SESSION_SECRET=
# Server only. Vercel Cron sends it to /api/cron/morning-reminder (rule M).
CRON_SECRET=
# "off" on every real deploy: hides the demo login (rehearsals and tests only, Prompt 10).
DEMO_LOGIN=
# Local data mode only (VERIQ_DATA=local): "email:password" makes an admin in the throwaway database
# for tests. Never set it on Vercel; real admins come from `npm run create-admin -- you@example.org`.
VERIQ_LOCAL_ADMIN=
# Rule R1: reports on real hospitals open only when this is exactly "on" (after the Data Protection
# Commission registration). Leave it unset everywhere until then.
REPORTS_LIVE=
# "on" only on the demo deployment (the pitch site): it opens in demo mode and sends no reminders.
# Never set it on the real site (docs/DEPLOY.md).
VERIQ_DEMO_SITE=
